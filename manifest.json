{
  "manifest_version": 2,
  "name": "Tab Counter",
  "version": "1.0",
  "description": "Shows open tab count as window/total on the toolbar icon.",
  "permissions": ["tabs"],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_title": "Tab Counter"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-counter@local.script"
    }
  }
}
